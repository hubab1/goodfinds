{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "output/**",
    ".local/**",
    "formal/.lake/**",
    ".mcp.json",
    ".codex-plugin/plugin.json",
    "apps/server/target/**",
    "apps/server/data/contracts.json",
    "apps/server/tests/data/*.json",
    "apps/server/src/seller_parity_fixture.json",
    "apps/server/src/currency_formats.json"
  ]
}
