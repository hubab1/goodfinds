{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goodfinds-website",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./website",
    "not_found_handling": "none",
  },
  "routes": [
    {
      "pattern": "goodfinds.thirdtechapps.com",
      "custom_domain": true,
    },
  ],
}
