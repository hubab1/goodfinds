{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "import", "unicorn", "node", "oxc"],
  "jsPlugins": [{ "name": "node-test", "specifier": "eslint-node-test" }],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-console": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react-perf/jsx-no-new-array-as-prop": ["error", { "nativeAllowList": "all" }],
    "react-perf/jsx-no-new-object-as-prop": ["error", { "nativeAllowList": "all" }],
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_meta", "__GOODFINDS_PREVIEW__"]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "node-test/assertion-arguments": "error",
        "node-test/no-assert-throws-async": "error",
        "node-test/no-assert-throws-call": "error",
        "node-test/no-async-describe": "error",
        "node-test/no-callback-and-promise": "error",
        "node-test/no-conflicting-modifiers": "error",
        "node-test/no-identical-title": "error",
        "node-test/no-only-test": "error",
        "node-test/no-unawaited-promise-assertion": "error",
        "node-test/no-unawaited-rejects": "error",
        "node-test/no-unknown-test-options": "error",
        "node-test/prefer-strict-assert": "error",
        "node-test/require-throws-validator-return-true": "error",
        "node-test/valid-describe-callback": "error"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "dist/**", "output/**", ".local/**", "formal/.lake/**"]
}
