  {
    "schema_version": 1,
    "version": 3,
    "category": "rental",
    "title": "Property to rent",
    "description": "Choose the place and living arrangement that suit you.",
    "price": {
      "currency": "GBP",
      "period": "month"
    },
    "comparison_attributes": ["area", "accommodation", "property_type", "bedrooms"],
    "fields": [
      {
        "id": "area",
        "label": "Area or neighbourhood",
        "type": "location",
        "required": true,
        "hint": "Use the same area name when recording listing evidence.",
        "match": {
          "attribute": "area",
          "operator": "eq",
          "importance": "required"
        }
      },
      {
        "id": "accommodation",
        "label": "What would you like to rent?",
        "type": "single_choice",
        "required": true,
        "options": [
          {
            "value": "whole_property",
            "label": "Whole property"
          },
          {
            "value": "private_room",
            "label": "Private room"
          },
          {
            "value": "shared_room",
            "label": "Shared room"
          }
        ],
        "match": {
          "attribute": "accommodation",
          "operator": "eq",
          "importance": "required"
        }
      },
      {
        "id": "property_type",
        "label": "Property type",
        "type": "multiple_choice",
        "required": false,
        "options": [
          {
            "value": "house",
            "label": "House"
          },
          {
            "value": "flat",
            "label": "Flat"
          }
        ],
        "match": {
          "attribute": "property_type",
          "operator": "in",
          "importance": "required"
        }
      },
      {
        "id": "min_bedrooms",
        "label": "Minimum bedrooms",
        "type": "integer",
        "required": false,
        "minimum": 0,
        "maximum": 50,
        "unit": "bedrooms",
        "options": [
          {
            "value": 0,
            "label": "0"
          },
          {
            "value": 1,
            "label": "1"
          },
          {
            "value": 2,
            "label": "2"
          },
          {
            "value": 3,
            "label": "3"
          },
          {
            "value": 4,
            "label": "4"
          },
          {
            "value": 5,
            "label": "5"
          }
        ],
        "visible_when": {
          "field": "accommodation",
          "one_of": ["whole_property"]
        },
        "match": {
          "attribute": "bedrooms",
          "operator": "gte",
          "importance": "required"
        }
      },
      {
        "id": "floor",
        "label": "Floor preference",
        "type": "single_choice",
        "required": false,
        "options": [
          {
            "value": "ground",
            "label": "Ground floor"
          },
          {
            "value": "above_ground",
            "label": "Above ground floor"
          }
        ],
        "match": {
          "attribute": "floor",
          "operator": "eq",
          "importance": "required"
        }
      },
      {
        "id": "max_price_minor",
        "label": "Maximum monthly rent",
        "type": "integer",
        "required": true,
        "minimum": 1,
        "maximum": 100000000,
        "display_divisor": 100,
        "unit": "\u00a3 / month",
        "hint": "Full monthly rent, excluding separately quoted bills and deposits.",
        "match": {
          "attribute": "price_minor",
          "operator": "lte",
          "importance": "required"
        }
      },
